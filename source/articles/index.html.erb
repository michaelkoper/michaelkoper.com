---
pageable: true
per_page: 10
title: Articles
description: Thoughts on building SaaS products and software development
layout: layout
---

<h1 class="max-w-[35ch] text-3xl font-semibold tracking-tight text-balance text-white sm:text-4xl">Articles</h1>
<p class="mt-4 max-w-[48ch] text-pretty text-purple-light/80">
  Thoughts on building SaaS products and software development.
</p>

<ul role="list" class="mt-12 space-y-10">
  <% page_articles.each do |article| %>
    <li>
      <article>
        <h2 class="text-xl font-semibold text-balance"><%= link_to article.title, article, class: "text-white underline-offset-4 hover:underline" %></h2>
        <p class="mt-1 text-base text-purple-light/70 sm:text-sm">
          <time datetime="<%= article.date.strftime('%Y-%m-%d') %>"><%= article.date.strftime('%B %-e, %Y') %></time>
        </p>
      </article>
    </li>
  <% end %>
</ul>

<% if paginate && (prev_page || next_page) %>
  <nav aria-label="Pagination" class="mt-14 flex items-center justify-between border-t border-white/10 pt-8">
    <% if prev_page %>
      <%= link_to "← Newer articles", prev_page, class: "text-lime underline decoration-lime/40 underline-offset-4 hover:decoration-lime" %>
    <% else %>
      <span></span>
    <% end %>
    <% if next_page %>
      <%= link_to "Older articles →", next_page, class: "text-lime underline decoration-lime/40 underline-offset-4 hover:decoration-lime" %>
    <% end %>
  </nav>
<% end %>
