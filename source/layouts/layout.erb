<!doctype html>
<html lang="en" class="antialiased scheme-only-dark">
  <head>
    <% description = current_page.data.description || "Michael Koper, a Dutch full-stack developer living in Madrid, Spain. Founder of Nusii" %>
    <% title = current_page.data.title || "Personal website of Michael Koper - Founder Nusii" %>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="ROBOTS" content="INDEX,FOLLOW">
    <meta name="description" content="<%= description %>">
    <meta name="author" content="Michael Koper">

    <title><%= current_page.data.title || "Personal website of Michael Koper - Co-founder Nusii - Software Engineer" %></title>

    <link rel="preconnect" href="https://use.typekit.net" crossorigin>
    <link rel="stylesheet" href="https://use.typekit.net/hyd3srd.css">
    <%= stylesheet_link_tag "tailwind" %>

    <link rel="canonical" href="<%= full_url %>" />

    <meta property="og:title" content="<%= title %>" />
    <meta property="og:url" content="<%= full_url %>" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:site_name" content="Michael Koper" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://ogkit.dev/img/gy1Es5R9.jpeg?url=<%= ERB::Util.url_encode(full_url) %>" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= title %>" />
    <meta name="twitter:description" content="<%= description %>" />
    <meta name="twitter:site" content="@michaelkoper" />
    <meta name="twitter:creator" content="@michaelkoper" />
    <meta name="twitter:image" content="https://ogkit.dev/img/gy1Es5R9.jpeg?url=<%= ERB::Util.url_encode(full_url) %>" />

    <script src="https://cdn.usefathom.com/script.js" data-site="LNDZXZRW" defer></script>
  </head>
  <body class="flex min-h-dvh flex-col bg-purple-dark font-calluna text-lg/8 font-light text-purple-light">
    <%= partial "header" %>
    <main class="isolate flex-1 py-12 md:py-24">
      <div class="mx-auto w-full max-w-2xl px-6">
        <%= yield %>
      </div>
    </main>
    <%= partial "footer" %>
    <%= javascript_include_tag "main" %>

    <%= partial "ogkit_template", locals: { title: title } %>
  </body>
</html>
