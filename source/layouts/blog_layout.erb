<!doctype html>
<html lang="en" class="antialiased scheme-only-dark">
  <head>
    <% description = current_page.data.description || "Michael Koper, a Dutch full-stack developer living in Madrid, Spain. Founder of Nusii" %>
    <% title = current_page.data.title || "Blog - Michael Koper" %>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="ROBOTS" content="INDEX,FOLLOW">
    <meta name="description" content="<%= description %>">
    <meta name="author" content="Michael Koper">

    <title><%= title %> - Michael Koper</title>

    <link rel="preconnect" href="https://use.typekit.net" crossorigin>
    <link rel="stylesheet" href="https://use.typekit.net/hyd3srd.css">
    <%= stylesheet_link_tag "tailwind" %>

    <link rel="canonical" href="https://michaelkoper.com<%= current_page.url %>" />

    <meta property="og:title" content="<%= title %>" />
    <meta property="og:url" content="<%= full_url %>" />
    <meta property="og:description" content="<%= description %>" />
    <meta property="og:site_name" content="Michael Koper" />
    <meta property="og:type" content="article" />
    <meta property="og:image" content="https://ogkit.dev/img/gy1Es5R9.jpeg?url=<%= ERB::Util.url_encode(full_url) %>" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= title %>" />
    <meta name="twitter:description" content="<%= description %>" />
    <meta name="twitter:site" content="@michaelkoper" />
    <meta name="twitter:creator" content="@michaelkoper" />
    <meta name="twitter:image" content="https://ogkit.dev/img/gy1Es5R9.jpeg?url=<%= ERB::Util.url_encode(full_url) %>" />

    <script src="https://cdn.usefathom.com/script.js" data-site="LNDZXZRW" defer></script>
  </head>
  <body class="flex min-h-dvh flex-col bg-purple-dark font-calluna text-lg/8 font-light text-purple-light">
    <%= partial "header" %>
    <main class="isolate flex-1 py-12 md:py-24">
      <div class="mx-auto w-full max-w-2xl px-6">
        <% if current_page.data.date %>
          <p class="mb-4 text-base text-purple-light/70 sm:text-sm">
            <time datetime="<%= current_page.data.date.strftime('%Y-%m-%d') %>"><%= current_page.data.date.strftime('%B %-e, %Y') %></time>
          </p>
        <% end %>

        <article class="prose max-w-[70ch]">
          <%= yield %>
        </article>

        <p class="mt-16 border-t border-white/10 pt-10">
          <%= link_to "← Back to all articles", "/articles/", class: "text-lime underline decoration-lime/40 underline-offset-4 hover:decoration-lime" %>
        </p>
      </div>
    </main>
    <%= partial "footer" %>
    <%= javascript_include_tag "main" %>

    <%= partial "ogkit_template", locals: { title: title } %>
  </body>
</html>
